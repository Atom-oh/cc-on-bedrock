# Copy this file to terraform.tfvars and customise.
# Terraform is the canonical IaC surface.

aws_region = "ap-northeast-2"

# Network — existing VPC (the stack never creates a VPC/subnets/NAT/IGW)
vpc_name            = "cc-on-bedrock"
vpc_id              = "vpc-0123456789abcdef0"
public_subnet_ids   = ["subnet-aaaa", "subnet-bbbb"]
private_subnet_ids  = ["subnet-cccc", "subnet-dddd"] # NAT egress, two AZs
isolated_subnet_ids = ["subnet-eeee", "subnet-ffff"]
# Interface endpoints to add; drop any the VPC already has with private DNS.
interface_endpoint_services = ["ssm", "ssmmessages", "ec2messages", "ecr.api", "ecr.dkr", "bedrock-runtime", "logs"]
# SGs of endpoints the VPC already had; the locked DevEnv tier reaches only endpoint SGs on 443.
existing_vpc_endpoint_security_group_ids = []

# Domain
domain_name   = "example.com"
dev_subdomain = "dev"

# Models
opus_model_id   = "global.anthropic.claude-opus-4-8"
sonnet_model_id = "global.anthropic.claude-sonnet-5"
codex_model_id  = "global.openai.gpt-6.1-sol" # Codex CLI (ADR-014)

# Compute
dashboard_instance_type = "t4g.xlarge"
dashboard_image_tag     = "replace-with-commit-sha" # Required; must match the pushed dashboard image tag and must not be latest.
devenv_instance_type    = "t4g.large"
ecs_cluster_name        = "cc-on-bedrock-devenv"
daily_budget_usd        = 50 # per-user USD caps; any one exceeded = blocked (ADR-008)
weekly_budget_usd       = 0  # 0 = no global weekly cap (set per user/dept in Admin → Budgets)
monthly_budget_usd      = 0  # 0 = no global monthly cap
# "governance" (default): dashboard + local installer, no EC2. "devenv": adds per-user EC2 DevEnvs.
# Existing devenv stacks: set "devenv" here; "governance" destroys every DevEnv resource.
deployment_mode = "governance"
# Reuse an existing Cognito user pool (shared with another app) instead of creating one.
# Adds cc app clients, groups (admin/user/dept-manager) and custom attributes to it; the pool's
# own Lambda triggers are left alone. Switching an existing stack destroys cc-on-bedrock-users.
# Every other app client on that pool must restrict write_attributes (no custom:*) first.
# existing_cognito_user_pool_id = "ap-northeast-2_XXXXXXXXX"
